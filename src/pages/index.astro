---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout description="吾民的个人博客：学习笔记、项目复盘与生活记录">
  <section class="intro">
    <h1>你好，我是吾民 👋</h1>
    <p>这里记录我的学习笔记、项目复盘和生活碎片。用 Astro 搭建，写作只需要 Markdown。</p>
  </section>

  <section>
    <h2 class="section-title">最新文章</h2>
    {posts.length === 0 ? (
      <p>还没有文章，去 <code>src/content/blog/</code> 里新建一篇吧。</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a class="post-link" href={`/blog/${post.id}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
            <time datetime={post.data.pubDate.toISOString()}>
              {dateFormatter.format(post.data.pubDate)}
            </time>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
