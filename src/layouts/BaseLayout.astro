---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '吾民的博客',
  description = '记录学习、项目与生活的个人博客',
} = Astro.props;

const siteName = '吾民的博客';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{siteName}</a>
      <nav class="site-nav" aria-label="主导航">
        <a href="/">首页</a>
        <a href="/about/">关于</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} 吾民 · 由
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        驱动
      </p>
    </footer>
  </body>
</html>
